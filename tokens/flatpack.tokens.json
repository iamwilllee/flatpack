{
  "$description": "Flatpack UI design tokens. Single source of truth: flatpack.css, figma/flatpack-tokens.json, README.md and DESIGN_LANGUAGE.md are generated from this file by `npm run build:tokens`. Tune choices made on the Create page go into tokens/overrides.json (or `npm run build:tokens -- --preset <code>`), and are applied on top of this file.",
  "principles": [
    {
      "id": "shape",
      "zh": "形状按角色",
      "en": "Shape by role",
      "zhDesc": "可点的单行小件（按钮、筛选项、输入框、徽章）用一种圆角，承载内容的面（卡片、图片、表格）用另一种，没有中间值。默认前者是胶囊、后者是直角。浮在页面上的层（弹窗、菜单、Toast）单独用一种圆角，让里面的胶囊控件有一个相配的外框。想要全直角，选「直角」预设，主题也可以给内容面一个小圆角。",
      "enDesc": "Clickable single-line parts (buttons, chips, inputs, badges) share one radius; surfaces that hold content (cards, images, tables) share another. Nothing in between. By default the first is a pill and the second is square. Layers that float above the page (dialogs, menus, toasts) get their own radius, so the pill controls inside sit in a matching frame. For all-square pick the Square preset; a theme may give surfaces a small radius."
    },
    {
      "id": "mono",
      "zh": "黑白",
      "en": "Black and white",
      "zhDesc": "默认只有一个强调色，就是墨色。层级靠反差和字号拉开，不靠颜色。红、绿只用于状态文字和图标。主题可以把墨色换成自己的品牌色，但每个主题仍然只有一个强调色。",
      "enDesc": "There is one accent, and by default it is ink. Hierarchy comes from contrast and size, not color. Red and green are only for status text and icons. A theme may swap ink for its own brand color, but each theme still has exactly one accent."
    },
    {
      "id": "space",
      "zh": "留白",
      "en": "Whitespace",
      "zhDesc": "分区用间距。边框只有 1px 一种，卡片里不再套第二层边框。阴影只给浮层用。",
      "enDesc": "Space separates sections. There is one 1px border, and no second border inside a card. Shadows are for floating layers only."
    }
  ],
