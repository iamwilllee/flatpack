{
  "$description": "Flatpack UI design tokens. Single source of truth: flatpack.css, figma/flatpack-tokens.json, README.md and DESIGN_LANGUAGE.md are generated from this file by `npm run build:tokens`. Tune choices made on the Create page go into tokens/overrides.json (or `npm run build:tokens -- --preset <code>`), and are applied on top of this file.",
  "principles": [
    {
      "id": "shape",
      "zh": "形状按角色",
      "en": "Shape by role",
      "zhDesc": "可点的单行小件（按钮、筛选项、输入框、徽章）用胶囊，承载内容的面（卡片、图片、弹窗、表格）用直角，没有中间值。想要全直角，选「直角」预设。",
      "enDesc": "Clickable single-line parts (buttons, chips, inputs, badges) are pills; surfaces that hold content (cards, images, dialogs, tables) are square. Nothing in between. For all-square, pick the Square preset."
    },
    {
      "id": "mono",
      "zh": "黑白",
      "en": "Black and white",
      "zhDesc": "只有一个强调色，就是墨色。层级靠反差和字号拉开，不靠颜色。红、绿只用于状态文字和图标。",
      "enDesc": "There is one accent, and it is ink. Hierarchy comes from contrast and size, not color. Red and green are only for status text and icons."
    },
    {
      "id": "space",
      "zh": "留白",
      "en": "Whitespace",
      "zhDesc": "分区用间距。边框只有 1px 一种，卡片里不再套第二层边框。阴影只给浮层用。",
      "enDesc": "Space separates sections. There is one 1px border, and no second border inside a card. Shadows are for floating layers only."
    }
  ],
  "gray": {
